{
  "name": "gqlcage",
  "version": "1.0.0",
  "description": "Zero-dependency GraphQL query security firewall, iterative parser, and DoS and introspection auditor for Node.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/draarivpatel-ui/gqlcage.git"
  },
  "homepage": "https://github.com/draarivpatel-ui/gqlcage#readme",
  "bugs": {
    "url": "https://github.com/draarivpatel-ui/gqlcage/issues"
  },
  "type": "module",
  "main": "./cjs/index.cjs",
  "module": "./src/index.mjs",
  "types": "./types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.mjs",
      "require": "./cjs/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "gqlcage": "bin/gqlcage.mjs"
  },
  "files": [
    "bin",
    "src",
    "cjs",
    "types",
    "docs",
    "examples",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build:cjs": "node scripts/build-cjs.mjs",
    "check:cjs": "node scripts/build-cjs.mjs --check",
    "smoke": "node scripts/cli-smoke.mjs",
    "test": "node scripts/run-tests.mjs"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "security",
    "graphql",
    "graphql-security",
    "dos",
    "introspection",
    "query-cost",
    "cwe-400",
    "cwe-776",
    "zero-dependency",
    "firewall",
    "nodejs"
  ],
  "license": "MIT",
  "sideEffects": false,
  "dependencies": {},
  "devDependencies": {}
}
